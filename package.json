{
  "name": "connect-labs",
  "version": "0.1.0",
  "devDependencies": {
    "@babel/core": "^7.16.5",
    "@babel/preset-env": "^7.16.5",
    "@babel/preset-react": "^7.16.5",
    "@babel/preset-typescript": "^7.16.5",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@ryangjchandler/alpine-tooltip": "^2.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@turf/circle": "^7.4.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "alpinejs": "^3.16.3",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^9.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "concurrently": "^8.0.1",
    "css-loader": "^6.5.1",
    "dotenv-webpack": "^8.0.1",
    "flatpickr": "^4.6.13",
    "htmx.org": "^1.9.4",
    "lucide-react": "^0.263.1",
    "mapbox-gl": "^3.29.0",
    "mini-css-extract-plugin": "^2.10.2",
    "open-chat-studio-widget": "^0.12.0",
    "postcss": "^8.5.3",
    "postcss-loader": "^7.0.2",
    "postcss-preset-env": "^8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.103.1",
    "sass-loader": "^13.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.11",
    "tippy.js": "^6.3.7",
    "tom-select": "^2.6.2",
    "tw-animate-css": "^1.0.1",
    "typescript": "^5.3.0",
    "webpack": "^5.110.1",
    "webpack-bundle-tracker": "^2.0.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^4.6.0",
    "webpack-merge": "^5.8.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "18"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "babel": {
    "presets": [
      "@babel/preset-env",
      [
        "@babel/preset-react",
        {
          "runtime": "automatic"
        }
      ],
      "@babel/preset-typescript"
    ]
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --mode production --config webpack/prod.config.js && npm run build:campaign && npm run build:supply",
    "build:campaign": "node webpack/build-campaign.js",
    "watch:campaign": "node webpack/build-campaign.js --watch",
    "build:supply": "node webpack/build-supply.js",
    "watch:supply": "node webpack/build-supply.js --watch",
    "dev": "webpack --mode development --config webpack/base.config.js && npm run build:campaign && npm run build:supply",
    "dev-watch": "concurrently -k -n webpack,campaign,supply \"webpack --mode development --config webpack/base.config.js --watch\" \"npm run watch:campaign\" \"npm run watch:supply\"",
    "test": "vitest run && npm run test:units",
    "test:units": "node connect_labs/static/labs/context_picker.test.mjs && node connect_labs/static/microplans/shared.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@tailwindcss/typography": "^0.5.20",
    "@xyflow/react": "^12.11.5",
    "ai": "^5.0.249",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "motion": "^12.23.24",
    "nanoid": "^5.1.6",
    "shiki": "^3.15.0",
    "streamdown": "^1.5.1",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6"
  }
}
