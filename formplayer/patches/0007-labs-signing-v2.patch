+     * verifier can each be checked against the same bytes. docs/labs-mode.md repeats it.
+     */
+    @Test
+    public void v2_pinnedVector() throws Exception {
+        assertEquals("9c9693505a92809cf6df03095cf759961f7d46af411684b0392f269c1a42e835",
+                LabsAuthFilter.sha256Hex(TOKEN));
+        assertEquals("XzkwQmqZlP49L49fg9Jt+sTd0iQvLcoP8pPDFTGKDIU=",
+                signV2("POST", "/navigate_menu", NOW, TOKEN, EU, BODY));
+        assertEquals("xjkw+rroZdGkpL9AMdktQ3sCa2Yg+0YJclrBIxgmo0k=",
+                signV2("POST", "/navigate_menu", NOW, TOKEN, null, BODY));
+        Result result = run(v2Request(BODY, NOW, "XzkwQmqZlP49L49fg9Jt+sTd0iQvLcoP8pPDFTGKDIU=",
+                TOKEN, EU), v2Filter(false));
+        assertTrue(result.chainCalled());
+        assertEquals(EU, ((HqUserDetailsBean)result.auth().getPrincipal()).getLabsHqHost());
+    }
+
