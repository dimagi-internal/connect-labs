+    // ── Signing v2 ──────────────────────────────────────────────────────
+
+    private static final long NOW = 1767225600L; // 2026-01-01T00:00:00Z
+    private static final String EU = "https://eu.commcarehq.org";
+
+    private LabsAuthFilter v2Filter(boolean allowV1) {
+        return new LabsAuthFilter(KEY, java.util.List.of("https://www.commcarehq.org", EU),
+                allowV1, () -> NOW);
+    }
+
+    private static String signV2(String method, String path, long ts, String token, String host,
+            String body) throws Exception {
+        return LabsAuthFilter.sign(KEY.getBytes(StandardCharsets.UTF_8),
+                LabsAuthFilter.canonicalV2(method, path, Long.toString(ts), token, host,
+                        body.getBytes(StandardCharsets.UTF_8)));
+    }
+
+    private static MockHttpServletRequest v2Request(String body, long ts, String signature,
+            String token, String host) {
+        MockHttpServletRequest request = request(body, null, token);
+        request.addHeader(Constants.LABS_TIMESTAMP_HEADER, Long.toString(ts));
+        request.addHeader(Constants.LABS_SIGNATURE_V2_HEADER, signature);
+        if (host != null) {
+            request.addHeader(Constants.LABS_HQ_HOST_HEADER, host);
+        }
+        return request;
+    }
+
+    /**
