+    /**
+     * The bytes a v2 signature covers: the UTF-8 header block
+     * {@code "v2\n" + METHOD + "\n" + path + "\n" + timestamp + "\n" + sha256hex(token) + "\n"
+     * + (X-Labs-HQ-Host value or "") + "\n"}, followed by the signed bytes (raw body, or the
+     * multipart JSON part). {@code path} is the request URI path as received (no query string),
+     * {@code token} the normalized token (no "Bearer " prefix), and the host the header's exact
+     * value.
+     */
+    public static byte[] canonicalV2(String method, String path, String timestamp, String token,
+            String hqHostHeader, byte[] signedBytes) throws Exception {
+        String head = "v2\n" + method + "\n" + path + "\n" + timestamp + "\n"
+                + sha256Hex(token) + "\n" + (hqHostHeader == null ? "" : hqHostHeader) + "\n";
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        out.write(head.getBytes(StandardCharsets.UTF_8));
+        out.write(signedBytes);
+        return out.toByteArray();
+    }
+
+    static String sha256Hex(String value) throws Exception {
+        byte[] digest = MessageDigest.getInstance("SHA-256")
+                .digest(value.getBytes(StandardCharsets.UTF_8));
+        StringBuilder hex = new StringBuilder(digest.length * 2);
+        for (byte b : digest) {
+            hex.append(String.format("%02x", b));
+        }
+        return hex.toString();
+    }
+
