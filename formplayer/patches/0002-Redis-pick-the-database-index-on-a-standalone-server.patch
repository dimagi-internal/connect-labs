From 977dfe090f19eb79ac6dc7794b41b3b277ba2615 Mon Sep 17 00:00:00 2001
From: Jonathan Jackson <70459+jjackson@users.noreply.github.com>
Date: Wed, 25 Nov 2026 00:48:48 +0000
Subject: [PATCH 2/2] Redis: pick the database index on a standalone server
 (REDIS_DATABASE)

Formplayer always used database 0, so it could not share a Redis server
with another app without sharing its keyspace. redis.database (env
REDIS_DATABASE, default 0) sets the index for the standalone
connection; Redis Cluster mode is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 docs/labs-mode.md                                           | 2 +-
 .../org/commcare/formplayer/application/WebAppContext.java  | 6 ++++++
 src/main/resources/application.properties                   | 1 +
 3 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/docs/labs-mode.md b/docs/labs-mode.md
index 341c9522..1e201e99 100644
--- a/docs/labs-mode.md
+++ b/docs/labs-mode.md
@@ -14,7 +14,7 @@ HQ's HMAC key. It is off by default. When it is off, formplayer behaves exactly
 | `AUTH_KEY` | `commcarehq.formplayerAuthKey` | Still a required property. Labs never uses it, so set it to any random value unless HQ also calls this instance. |
 | `EXTERNAL_REQUEST_MODE` | `formplayer.externalRequestMode` | Leave empty in production. `replace-host` rewrites every outbound host to `COMMCARE_HOST` (dev or mocks only). |
 | `POSTGRESQL_HOST` / `_PORT` / `_DATABASE` / `_USERNAME` / `POSTGRESQL_PASSWROD` (sic) | `spring.datasource.*` | Postgres 10+ holds form/menu sessions, Flyway-migrated on boot. |
-| `REDIS_HOSTNAME` / `REDIS_PASSWORD` | `redis.*` | Redis holds locks, the CCZ archive index, sync and volatility caches. |
+| `REDIS_HOSTNAME` / `REDIS_PASSWORD` / `REDIS_DATABASE` (0) | `redis.*` | Redis holds locks, the CCZ archive index, sync and volatility caches. `REDIS_DATABASE` picks the database index on a standalone Redis, so formplayer can share a server without sharing a keyspace. |
 | `SERVER_PORT` (8080) | `server.port` | API port. |
 | `MANAGEMENT_SERVER_PORT` (8081) | `management.server.port` | `GET /health` (db and redis), `/info`, `/metrics`. Keep it private. |
 | `sqlite.dataDir` (`dbs/`), `sqlite.tmpDataDir` (`tmp_dbs/`) | same | Local disk for per-user and per-app SQLite sandboxes, and the downloaded CCZs. Use a persistent volume; losing it only forces a reinstall and restore. |
diff --git a/src/main/java/org/commcare/formplayer/application/WebAppContext.java b/src/main/java/org/commcare/formplayer/application/WebAppContext.java
index 56dcb874..d9d54212 100644
--- a/src/main/java/org/commcare/formplayer/application/WebAppContext.java
+++ b/src/main/java/org/commcare/formplayer/application/WebAppContext.java
@@ -76,6 +76,11 @@ public class WebAppContext implements WebMvcConfigurer {
     @Value("${redis.password:#{null}}")
     private String redisPassword;
 
+    // Standalone mode only (a Redis Cluster has no databases). Lets formplayer share a Redis
+    // server with other apps without sharing their keyspace.
+    @Value("${redis.database:0}")
+    private int redisDatabase;
+
     @Value("${detailed_tagging.tag_names:}")
     private List<String> detailedTagNames;
 
@@ -113,6 +118,7 @@ public class WebAppContext implements WebMvcConfigurer {
         } else {
             RedisStandaloneConfiguration config = new RedisStandaloneConfiguration(redisHostName);
             config.setPassword(redisPassword);
+            config.setDatabase(redisDatabase);
             return new JedisConnectionFactory(config);
         }
     }
diff --git a/src/main/resources/application.properties b/src/main/resources/application.properties
index f57c9081..4a9dac3d 100644
--- a/src/main/resources/application.properties
+++ b/src/main/resources/application.properties
@@ -70,6 +70,7 @@ formplayer.labs.authKey=${LABS_AUTH_KEY:}
 server.port=${SERVER_PORT:8080}
 redis.hostname=${REDIS_HOSTNAME:redis}
 redis.password=${REDIS_PASSWORD:}
+redis.database=${REDIS_DATABASE:0}
 
 sentry.dsn=${SENTRY_DSN:}
 
