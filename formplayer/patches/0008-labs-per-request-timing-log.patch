diff --git a/src/main/java/org/commcare/formplayer/util/LabsRequestStats.java b/src/main/java/org/commcare/formplayer/util/LabsRequestStats.java
new file mode 100644
index 00000000..8f90fa34
--- /dev/null
+++ b/src/main/java/org/commcare/formplayer/util/LabsRequestStats.java
@@ -0,0 +1,102 @@
+package org.commcare.formplayer.util;
+
+import org.apache.commons.logging.Log;
+import org.apache.commons.logging.LogFactory;
+import org.json.JSONObject;
+import org.springframework.web.context.request.RequestAttributes;
+import org.springframework.web.context.request.RequestContextHolder;
+
+import jakarta.servlet.http.HttpServletRequest;
+
+/**
+ * Labs mode: what one request cost, written as one INFO JSON line on the {@code labs.request}
+ * logger when it finishes:
+ *
+ * <pre>{"event":"labs_request","endpoint":"/navigate_menu","status":200,"ms":412,
+ *  "lock_wait_ms":0,"installed":false,"restored":true,"domain":"my-domain","sig":"v2"}</pre>
+ *
+ * <p>{@code restored} means the request downloaded a restore from HQ, {@code installed} that it
+ * installed an app (both from {@code ResponseMetaDataTracker}); {@code lock_wait_ms} is the time
+ * spent waiting for the user's lock ({@code LockAspect}). Never a username or a token.
+ *
+ * <p>{@code LabsAuthFilter} starts one per labs request and stores it as a request attribute; the
+ * recorders below find it through the current request and do nothing outside a labs request.
+ */
+public class LabsRequestStats {
+
+    public static final String ATTRIBUTE = LabsRequestStats.class.getName();
+    private static final Log requestLog = LogFactory.getLog("labs.request");
+
+    private final long startNanos = System.nanoTime();
+    private long lockWaitMs = 0;
+    private boolean installed = false;
+    private boolean restored = false;
+    private String domain;
+    private String signature;
+
+    public static LabsRequestStats start(HttpServletRequest request) {
+        LabsRequestStats stats = new LabsRequestStats();
+        request.setAttribute(ATTRIBUTE, stats);
+        return stats;
+    }
+
+    private static LabsRequestStats current() {
+        RequestAttributes attributes = RequestContextHolder.getRequestAttributes();
+        if (attributes == null) {
+            return null;
+        }
+        Object stats = attributes.getAttribute(ATTRIBUTE, RequestAttributes.SCOPE_REQUEST);
+        return stats instanceof LabsRequestStats ? (LabsRequestStats)stats : null;
+    }
+
+    public static void recordLockWait(long ms) {
+        LabsRequestStats stats = current();
+        if (stats != null) {
+            stats.lockWaitMs += ms;
+        }
+    }
+
+    public static void markRestored() {
+        LabsRequestStats stats = current();
+        if (stats != null) {
+            stats.restored = true;
+        }
+    }
+
+    public static void markInstalled() {
+        LabsRequestStats stats = current();
+        if (stats != null) {
+            stats.installed = true;
+        }
+    }
+
+    public void setDomain(String domain) {
+        this.domain = domain;
+    }
+
+    /**
+     * "v1" or "v2": the scheme the request was signed with. Set before verification, so a 401
+     * line says which scheme failed (status tells whether it was accepted).
+     */
+    public void setSignature(String signature) {
+        this.signature = signature;
+    }
+
+    public String toJson(String endpoint, int status) {
+        long ms = (System.nanoTime() - startNanos) / 1_000_000;
+        return "{\"event\":\"labs_request\""
+                + ",\"endpoint\":" + JSONObject.quote(endpoint)
+                + ",\"status\":" + status
+                + ",\"ms\":" + ms
+                + ",\"lock_wait_ms\":" + lockWaitMs
+                + ",\"installed\":" + installed
+                + ",\"restored\":" + restored
+                + ",\"domain\":" + (domain == null ? "null" : JSONObject.quote(domain))
+                + ",\"sig\":" + (signature == null ? "null" : JSONObject.quote(signature))
+                + "}";
+    }
+
+    public void log(String endpoint, int status) {
+        requestLog.info(toJson(endpoint, status));
+    }
+}
