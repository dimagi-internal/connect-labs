+    // ── Per-request log line ────────────────────────────────────────────
+
+    private static ch.qos.logback.core.read.ListAppender<ch.qos.logback.classic.spi.ILoggingEvent>
+            captureRequestLog() {
+        ch.qos.logback.classic.Logger logger = (ch.qos.logback.classic.Logger)
+                org.slf4j.LoggerFactory.getLogger("labs.request");
+        logger.setLevel(ch.qos.logback.classic.Level.INFO);
+        ch.qos.logback.core.read.ListAppender<ch.qos.logback.classic.spi.ILoggingEvent> appender =
+                new ch.qos.logback.core.read.ListAppender<>();
+        appender.start();
+        logger.addAppender(appender);
+        return appender;
+    }
+
+    private static void releaseRequestLog(
+            ch.qos.logback.core.read.ListAppender<ch.qos.logback.classic.spi.ILoggingEvent> appender) {
+        ((ch.qos.logback.classic.Logger)org.slf4j.LoggerFactory.getLogger("labs.request"))
+                .detachAppender(appender);
+    }
+
+    @Test
+    public void requestLog_oneJsonLinePerLabsRequest() throws Exception {
+        var appender = captureRequestLog();
+        try {
+            MockHttpServletRequest request = request(BODY, sign(BODY), TOKEN);
+            MockHttpServletResponse response = new MockHttpServletResponse();
+            filter.doFilter(request, response, (req, res) -> {
+                // What the controllers and aspects record on the request thread.
+                org.springframework.web.context.request.RequestContextHolder.setRequestAttributes(
+                        new org.springframework.web.context.request.ServletRequestAttributes(
+                                (jakarta.servlet.http.HttpServletRequest)req));
+                try {
+                    org.commcare.formplayer.util.LabsRequestStats.recordLockWait(7);
+                    org.commcare.formplayer.util.LabsRequestStats.markRestored();
+                    ((MockHttpServletResponse)res).setStatus(200);
+                } finally {
+                    org.springframework.web.context.request.RequestContextHolder
+                            .resetRequestAttributes();
+                }
+            });
+            run(request(BODY, sign("{}"), TOKEN)); // rejected: logged too
+            run(request(BODY, null, null)); // not a labs request: not logged
+
+            assertEquals(2, appender.list.size());
+            org.json.JSONObject ok = new org.json.JSONObject(appender.list.get(0).getFormattedMessage());
+            assertEquals("labs_request", ok.getString("event"));
+            assertEquals("/navigate_menu", ok.getString("endpoint"));
+            assertEquals(200, ok.getInt("status"));
+            assertTrue(ok.getLong("ms") >= 0);
+            assertEquals(7, ok.getLong("lock_wait_ms"));
+            assertTrue(ok.getBoolean("restored"));
+            assertFalse(ok.getBoolean("installed"));
+            assertEquals("connect-dom", ok.getString("domain"));
+            assertEquals("v1", ok.getString("sig"));
+            assertEquals(ch.qos.logback.classic.Level.INFO, appender.list.get(0).getLevel());
+
+            org.json.JSONObject rejected = new org.json.JSONObject(
+                    appender.list.get(1).getFormattedMessage());
+            assertEquals(401, rejected.getInt("status"));
+            assertTrue(rejected.isNull("domain"));
+            // The scheme it tried, even though it failed: the status says it was rejected.
+            assertEquals("v1", rejected.getString("sig"));
+
+            for (var event : appender.list) {
+                assertFalse(event.getFormattedMessage().contains(TOKEN));
+                assertFalse(event.getFormattedMessage().contains("worker1"));
+            }
+        } finally {
+            releaseRequestLog(appender);
+        }
+    }
+
+    @Test
+    public void requestLog_recordersAreNoOpsOutsideALabsRequest() {
+        org.commcare.formplayer.util.LabsRequestStats.recordLockWait(5);
+        org.commcare.formplayer.util.LabsRequestStats.markInstalled();
+        org.commcare.formplayer.util.LabsRequestStats.markRestored();
+    }
+
     private static void assertUnauthorized(Result result) {
         assertFalse(result.chainCalled());
         assertEquals(HttpServletResponse.SC_UNAUTHORIZED, result.response().getStatus());
