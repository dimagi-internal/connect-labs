     private static final String BEARER_PREFIX = "Bearer ";
 
     private final byte[] labsKey;
+    private final java.util.Set<String> allowedHqHosts;
     private final WebAuthenticationDetailsSource detailsSource = new WebAuthenticationDetailsSource();
 
     public LabsAuthFilter(String labsKey) {
+        this(labsKey, java.util.Collections.emptySet());
+    }
+
+    /**
+     * @param allowedHqHosts the HQ servers (scheme://host) a request may name in
+     *     {@link Constants#LABS_HQ_HOST_HEADER}; any other value is rejected.
+     */
+    public LabsAuthFilter(String labsKey, java.util.Collection<String> allowedHqHosts) {
         if (labsKey == null || labsKey.isBlank()) {
             throw new IllegalArgumentException(
                     "formplayer.labs.authKey must be set when formplayer.labs.enabled is true");
         }
         this.labsKey = labsKey.getBytes(StandardCharsets.UTF_8);
+        java.util.Set<String> hosts = new java.util.HashSet<>();
+        for (String host : allowedHqHosts) {
+            if (host != null && !host.isBlank()) {
+                hosts.add(normalizeHost(host));
+            }
+        }
+        this.allowedHqHosts = java.util.Collections.unmodifiableSet(hosts);
+    }
+
+    static String normalizeHost(String host) {
+        String h = host.trim();
+        while (h.endsWith("/")) {
+            h = h.substring(0, h.length() - 1);
+        }
+        return h.toLowerCase(java.util.Locale.ROOT);
     }
 
     public static boolean isLabsRequest(HttpServletRequest request) {
