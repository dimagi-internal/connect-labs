--- /dev/null
+++ b/src/main/java/org/commcare/formplayer/web/client/LabsHqHostInterceptor.java
@@ -0,0 +1,94 @@
+package org.commcare.formplayer.web.client;
+
+import org.commcare.formplayer.beans.auth.HqUserDetailsBean;
+import org.springframework.http.HttpRequest;
+import org.springframework.http.client.ClientHttpRequestExecution;
+import org.springframework.http.client.ClientHttpRequestInterceptor;
+import org.springframework.http.client.ClientHttpResponse;
+import org.springframework.security.core.Authentication;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.web.util.UriComponentsBuilder;
+
+import java.io.IOException;
+import java.net.URI;
+import java.net.URISyntaxException;
+
+import lombok.extern.apachecommons.CommonsLog;
+
+/**
+ * Labs mode: send a labs request's outbound HQ calls to the HQ server its worker lives on.
+ *
+ * <p>Formplayer builds every HQ URL (restore, app download, submission, readable questions) from
+ * the one configured {@code commcarehq.host}. A Connect worker may live on another HQ server (an
+ * EU opportunity's apps and users are on https://eu.commcarehq.org), so a labs request can name
+ * its server in X-Labs-HQ-Host; LabsAuthFilter checks it against formplayer.labs.hqHosts and puts
+ * it on the authenticated {@link HqUserDetailsBean}. This interceptor rewrites any outbound request
+ * aimed at the configured host to that server. Requests with no labs host, and requests already
+ * aimed elsewhere (an app profile's own PostURL, say), pass through unchanged.
+ *
+ * <p>It reads the security context of the calling thread, which is the request thread for every
+ * HQ call formplayer makes for a labs request.
+ */
+@CommonsLog
+public class LabsHqHostInterceptor implements ClientHttpRequestInterceptor {
+
+    private final URI configured;
+
+    public LabsHqHostInterceptor(String commcareHost) throws URISyntaxException {
+        this.configured = new URI(commcareHost);
+    }
+
+    static String currentLabsHqHost() {
+        Authentication auth = SecurityContextHolder.getContext().getAuthentication();
+        if (auth == null || !(auth.getPrincipal() instanceof HqUserDetailsBean)) {
+            return null;
+        }
+        HqUserDetailsBean details = (HqUserDetailsBean)auth.getPrincipal();
+        return details.isLabsSession() ? details.getLabsHqHost() : null;
+    }
+
+    URI rewrite(URI uri, String labsHost) throws URISyntaxException {
+        if (labsHost == null || !sameOrigin(uri, configured)) {
+            return uri;
+        }
+        URI target = new URI(labsHost);
+        if (sameOrigin(target, configured)) {
+            return uri;
+        }
+        return UriComponentsBuilder.fromUri(uri)
+                .scheme(target.getScheme())
+                .host(target.getHost())
+                .port(target.getPort())
+                .build(true)
+                .toUri();
+    }
+
+    private static boolean sameOrigin(URI a, URI b) {
+        return a.getScheme() != null && a.getScheme().equalsIgnoreCase(b.getScheme())
+                && a.getHost() != null && a.getHost().equalsIgnoreCase(b.getHost())
+                && effectivePort(a) == effectivePort(b);
+    }
+
+    private static int effectivePort(URI uri) {
+        if (uri.getPort() != -1) {
+            return uri.getPort();
+        }
+        return "https".equalsIgnoreCase(uri.getScheme()) ? 443 : 80;
+    }
+
+    @Override
+    public ClientHttpResponse intercept(HttpRequest request, byte[] body,
+            ClientHttpRequestExecution execution) throws IOException {
+        URI uri = request.getURI();
+        URI target;
+        try {
+            target = rewrite(uri, currentLabsHqHost());
+        } catch (URISyntaxException e) {
+            throw new IOException("bad labs HQ host", e);
+        }
+        if (!target.equals(uri)) {
+            request = new ReplaceUriHttpRequest(target, request);
+        }
+        return execution.execute(request, body);
+    }
+}
