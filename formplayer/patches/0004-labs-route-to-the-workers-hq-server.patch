--- /dev/null
+++ b/src/test/java/org/commcare/formplayer/web/client/LabsHqHostInterceptorTest.java
@@ -0,0 +1,47 @@
+package org.commcare.formplayer.web.client;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import org.junit.jupiter.api.Test;
+
+import java.net.URI;
+
+/** Labs mode: an EU worker's outbound HQ calls go to eu.commcarehq.org, nothing else moves. */
+public class LabsHqHostInterceptorTest {
+
+    private final LabsHqHostInterceptor interceptor;
+
+    public LabsHqHostInterceptorTest() throws Exception {
+        interceptor = new LabsHqHostInterceptor("https://www.commcarehq.org");
+    }
+
+    @Test
+    public void callToConfiguredHost_goesToTheWorkersServer() throws Exception {
+        URI uri = new URI("https://www.commcarehq.org/a/connect-demo/phone/restore/?version=2.0&device_id=WebAppsLogin");
+        assertEquals(
+                "https://eu.commcarehq.org/a/connect-demo/phone/restore/?version=2.0&device_id=WebAppsLogin",
+                interceptor.rewrite(uri, "https://eu.commcarehq.org").toString());
+    }
+
+    @Test
+    public void encodedQueryIsKept() throws Exception {
+        URI uri = new URI("https://www.commcarehq.org/a/d/apps/api/download_ccz/?app_id=abc&as=a%40b.org");
+        assertEquals("https://eu.commcarehq.org/a/d/apps/api/download_ccz/?app_id=abc&as=a%40b.org",
+                interceptor.rewrite(uri, "https://eu.commcarehq.org").toString());
+    }
+
+    @Test
+    public void noLabsHost_orSameHost_isUnchanged() throws Exception {
+        URI uri = new URI("https://www.commcarehq.org/a/d/phone/restore/");
+        assertEquals(uri, interceptor.rewrite(uri, null));
+        assertEquals(uri, interceptor.rewrite(uri, "https://www.commcarehq.org"));
+    }
+
+    @Test
+    public void callAlreadyAimedElsewhere_isUnchanged() throws Exception {
+        URI uri = new URI("https://eu.commcarehq.org/a/d/receiver/secure/build/");
+        assertEquals(uri, interceptor.rewrite(uri, "https://india.commcarehq.org"));
+        URI other = new URI("https://example.org/media.png");
+        assertEquals(other, interceptor.rewrite(other, "https://eu.commcarehq.org"));
+    }
+}
