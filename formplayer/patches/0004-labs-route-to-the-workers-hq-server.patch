+    @Test
+    public void allowedHqHost_isCarriedOnThePrincipal() throws Exception {
+        MockHttpServletRequest request = request(BODY, sign(BODY), TOKEN);
+        request.addHeader(Constants.LABS_HQ_HOST_HEADER, "https://EU.commcarehq.org/");
+        Result result = run(request, hostFilter);
+        assertTrue(result.chainCalled());
+        assertEquals("https://eu.commcarehq.org",
+                ((HqUserDetailsBean)result.auth().getPrincipal()).getLabsHqHost());
+    }
+
+    @Test
+    public void noHqHost_leavesTheConfiguredHost() throws Exception {
+        Result result = run(request(BODY, sign(BODY), TOKEN), hostFilter);
+        assertTrue(result.chainCalled());
+        assertNull(((HqUserDetailsBean)result.auth().getPrincipal()).getLabsHqHost());
+    }
+
+    @Test
+    public void unlistedHqHost_is401() throws Exception {
+        MockHttpServletRequest request = request(BODY, sign(BODY), TOKEN);
+        request.addHeader(Constants.LABS_HQ_HOST_HEADER, "https://evil.example.org");
+        Result result = run(request, hostFilter);
+        assertFalse(result.chainCalled());
+        assertEquals(401, result.response().getStatus());
+    }
+
     private Result run(MockHttpServletRequest request) throws Exception {
+        return run(request, filter);
+    }
+
+    private Result run(MockHttpServletRequest request, LabsAuthFilter filter) throws Exception {
         MockHttpServletResponse response = new MockHttpServletResponse();
         AtomicReference<Authentication> seen = new AtomicReference<>();
         final boolean[] called = {false};
diff --git a/src/test/java/org/commcare/formplayer/web/client/LabsHqHostInterceptorTest.java b/src/test/java/org/commcare/formplayer/web/client/LabsHqHostInterceptorTest.java
new file mode 100644
