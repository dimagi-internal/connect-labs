diff --git a/Dockerfile b/Dockerfile
index 10624005..679e3852 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -20,6 +20,10 @@ COPY --from=builder application/snapshot-dependencies/ ./
 COPY --from=builder application/spring-boot-loader/ ./
 COPY --from=builder application/application/ ./
 
+# sqlite.dataDir and sqlite.tmpDataDir (relative to WORKDIR). Created in the image so the nightly
+# purge finds tmp_dbs/ even on a fresh disk, and so a volume mounted over either starts usable.
+RUN mkdir -p dbs tmp_dbs
+
 COPY scripts/docker_entrypoint.sh /entrypoint
 RUN chmod +x /entrypoint
 ENTRYPOINT ["/entrypoint"]
