     public static int purgeTempDb(Instant cutOff) {
         File dbDir = new File(SQLiteProperties.getTempDataDir());
+        // Nothing has used a temp db since this disk was created (a fresh container, say): nothing
+        // to purge. Without this, FileUtils.deleteFiles NPEs on the missing directory's listFiles().
+        if (!dbDir.isDirectory()) {
+            return 0;
+        }
         try {
             return FileUtils.deleteFiles(dbDir, cutOff);
         } catch (IOException e) {
