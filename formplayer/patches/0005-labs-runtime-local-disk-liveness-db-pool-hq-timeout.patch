+package org.commcare.formplayer.util;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.commcare.formplayer.application.SQLiteProperties;
+import org.commcare.formplayer.sandbox.SqlSandboxUtils;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.File;
+import java.io.InputStream;
+import java.lang.reflect.Field;
+import java.nio.file.Path;
+import java.time.Instant;
+import java.util.Properties;
+
+/**
+ * The runtime defaults the labs deployment relies on: the nightly temp-db purge on a fresh disk,
+ * liveness probes, no open-session-in-view, a bounded DB pool, and an HQ read timeout that is
+ * upstream's unless configured.
+ */
+public class LabsRuntimeConfigTest {
+
+    @Test
+    public void purgeTempDb_onAMissingDirectory_purgesNothing(@TempDir Path tmp) throws Exception {
+        Field field = SQLiteProperties.class.getDeclaredField("tempDataDir");
+        field.setAccessible(true);
+        Object previous = field.get(null);
+        try {
+            new SQLiteProperties().setTempDataDir(tmp.resolve("never-created").toString() + "/");
+            assertEquals(0, SqlSandboxUtils.purgeTempDb(Instant.now()));
+        } finally {
+            field.set(null, previous);
+        }
+    }
+
+    @Test
+    public void purgeTempDb_deletesOldFiles(@TempDir Path tmp) throws Exception {
+        Field field = SQLiteProperties.class.getDeclaredField("tempDataDir");
+        field.setAccessible(true);
+        Object previous = field.get(null);
+        try {
+            File db = tmp.resolve("case-search.db").toFile();
+            assertTrue(db.createNewFile());
+            new SQLiteProperties().setTempDataDir(tmp.toString() + "/");
+            assertEquals(1, SqlSandboxUtils.purgeTempDb(Instant.now().plusSeconds(60)));
+            assertTrue(!db.exists());
+        } finally {
+            field.set(null, previous);
+        }
+    }
+
+    @Test
+    public void applicationProperties_setTheLabsRuntimeDefaults() throws Exception {
+        Properties props = new Properties();
+        try (InputStream in = getClass().getResourceAsStream("/application.properties")) {
+            props.load(in);
+        }
+        assertEquals("true", props.getProperty("management.endpoint.health.probes.enabled"));
+        assertEquals("${JPA_OPEN_IN_VIEW:false}", props.getProperty("spring.jpa.open-in-view"));
+        assertEquals("${DB_POOL_SIZE:20}",
+                props.getProperty("spring.datasource.hikari.maximum-pool-size"));
+        assertEquals("${DB_CONNECTION_TIMEOUT_MS:10000}",
+                props.getProperty("spring.datasource.hikari.connection-timeout"));
+        // Upstream's 15 minutes unless HQ_READ_TIMEOUT_MS says otherwise.
+        assertEquals("${HQ_READ_TIMEOUT_MS:" + Constants.READ_TIMEOUT + "}",
+                props.getProperty("formplayer.hq.readTimeoutMs"));
+    }
+}
