 docs/labs-mode.md                             |  7 +-
 .../formplayer/sandbox/SqlSandboxUtils.java   |  5 ++
 .../web/client/RestTemplateConfig.java        |  6 +-
 src/main/resources/application.properties     | 15 ++++
 .../util/LabsRuntimeConfigTest.java           | 70 +++++++++++++++++++
