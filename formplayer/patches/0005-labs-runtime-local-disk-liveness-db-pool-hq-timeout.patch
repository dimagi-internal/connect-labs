diff --git a/src/main/resources/application.properties b/src/main/resources/application.properties
index 2792fdeb..879e8095 100644
--- a/src/main/resources/application.properties
+++ b/src/main/resources/application.properties
@@ -6,6 +6,9 @@ spring.flyway.locations=classpath:org/commcare/formplayer/db/migration
 spring.flyway.table=schema_version
 
 spring.jpa.hibernate.ddl-auto=validate
+# No open-session-in-view: a request holds a pooled DB connection only while it is actually using
+# it, not for the whole (often HQ-bound) request. Nothing renders lazy associations in a view.
+spring.jpa.open-in-view=${JPA_OPEN_IN_VIEW:false}
 
 # we don't use repositories for redis so disable this to reduce warnings
 spring.data.redis.repositories.enabled=false
@@ -21,6 +24,10 @@ management.endpoints.web.base-path=/
 management.endpoints.web.exposure.include=health,info,metrics
 management.endpoint.health.show-details=never
 management.endpoint.health.show-components=always
+# /health/liveness and /health/readiness (Spring Boot only turns these on by itself on Kubernetes).
+# Liveness is the JVM's own state, not the database or Redis: a container orchestrator restarting
+# on liveness must not kill the only task over a blip on a shared Postgres or Redis.
+management.endpoint.health.probes.enabled=true
 # 1GB
 management.health.diskspace.threshold=1073742000
 
@@ -62,6 +69,10 @@ commcarehq.restore.url=${commcarehq.host}/a/{domain}/phone/restore/
 commcarehq.restore.url.case=${commcarehq.host}/a/{domain}/phone/case_restore/{case_id}/
 
 formplayer.externalRequestMode=${EXTERNAL_REQUEST_MODE:}
+# Read timeout on outbound HQ calls (restore, CCZ, submission, case search), in ms. Upstream's is
+# 15 minutes (Constants.READ_TIMEOUT); a deployment that would rather fail a stuck HQ call than hold
+# the user's lock that long sets it lower.
+formplayer.hq.readTimeoutMs=${HQ_READ_TIMEOUT_MS:900000}
 
 # Connect Web (connect-labs) mode, off by default. When on, requests signed with the labs key act
 # as the HQ mobile worker whose OAuth2 token they carry (see auth/LabsAuthFilter, docs/labs-mode.md).
@@ -80,6 +91,10 @@ spring.datasource.driver-class-name=org.postgresql.Driver
 spring.datasource.url=jdbc:postgresql://${POSTGRESQL_HOST:postgres}:${POSTGRESQL_PORT:5432}/${POSTGRESQL_DATABASE:formplayer}?prepareThreshold=0
 spring.datasource.username=${POSTGRESQL_USERNAME:commcarehq}
 spring.datasource.password=${POSTGRESQL_PASSWROD:commcarehq}
+# Explicit pool bounds (Hikari's defaults are 10 and 30 s): fail a request fast rather than queue it
+# behind a stuck pool.
+spring.datasource.hikari.maximum-pool-size=${DB_POOL_SIZE:20}
+spring.datasource.hikari.connection-timeout=${DB_CONNECTION_TIMEOUT_MS:10000}
 
 # --------------- set multipart file upload and request size limit
 spring.servlet.multipart.max-file-size=4MB
