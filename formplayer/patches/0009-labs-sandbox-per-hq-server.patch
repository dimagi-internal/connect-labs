@@ -0,0 +1,120 @@
+package org.commcare.formplayer.services;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.commcare.formplayer.DbUtils;
+import org.commcare.formplayer.auth.LabsAuthFilter;
+import org.commcare.formplayer.beans.auth.HqUserDetailsBean;
+import org.commcare.formplayer.util.Constants;
+import org.commcare.formplayer.util.RequestUtils;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.mock.web.MockHttpServletResponse;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.security.web.authentication.preauth.PreAuthenticatedAuthenticationToken;
+
+import java.io.File;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * Labs mode: the same domain and username on two HQ servers (www and eu) get separate sandboxes
+ * and sync-time keys; everything else keeps upstream's {@code dbs/<domain>/<user>}.
+ */
+public class LabsSandboxKeyTest {
+
+    private static final String WWW = "https://www.commcarehq.org";
+    private static final String EU = "https://eu.commcarehq.org";
+
+    @AfterEach
+    public void clear() {
+        SecurityContextHolder.clearContext();
+    }
+
+    private static void authenticate(String token, String labsHost) {
+        HqUserDetailsBean details = new HqUserDetailsBean("dom", new String[]{"dom"}, "worker1",
+                false, new String[]{}, new String[]{});
+        details.setLabsHqToken(token);
+        details.setLabsHqHost(labsHost);
+        SecurityContextHolder.getContext().setAuthentication(
+                new PreAuthenticatedAuthenticationToken(details, null, details.getAuthorities()));
+    }
+
+    private static String sep(String path) {
+        return path.replace("/", File.separator);
+    }
+
+    @Test
+    public void noRequest_isUpstream() {
+        assertEquals("dom", RequestUtils.getSandboxDomain("dom"));
+        assertEquals(sep("dom/worker1"), DbUtils.getDbPathSuffix("dom", "worker1", null));
+    }
+
+    @Test
+    public void labsDefaultServer_isUpstream() {
+        authenticate("token", null);
+        assertEquals("dom", RequestUtils.getSandboxDomain("dom"));
+        assertEquals(sep("dom/worker1"), DbUtils.getDbPathSuffix("dom", "worker1", null));
+    }
+
+    @Test
+    public void nonLabsSession_ignoresAnyHost() {
+        authenticate(null, EU); // no token: not a labs session
+        assertEquals("dom", RequestUtils.getSandboxDomain("dom"));
+    }
+
+    @Test
+    public void labsOtherServer_getsItsOwnSandboxAndSyncKey() {
+        authenticate("token", EU);
+        assertEquals("dom@eu.commcarehq.org", RequestUtils.getSandboxDomain("dom"));
+        assertEquals(sep("dom@eu.commcarehq.org/worker1"),
+                DbUtils.getDbPathSuffix("dom", "worker1", null));
+        assertTrue(DbUtils.getDbPathForUser("dom", "worker1", null)
+                .endsWith(sep("dom@eu.commcarehq.org/worker1")));
+
+        RestoreFactory factory = new RestoreFactory();
+        factory.setDomain("dom");
+        factory.setUsername("worker1");
+        assertEquals("last-sync-time:dom@eu.commcarehq.org:worker1:null", factory.lastSyncKey());
+
+        SecurityContextHolder.clearContext();
+        assertEquals("last-sync-time:dom:worker1:null", factory.lastSyncKey());
+    }
+
+    @Test
+    public void hostSlug_keepsANonDefaultPortAndNothingUnsafe() {
+        authenticate("token", "http://localhost:8000");
+        assertEquals("dom@localhost-8000", RequestUtils.getSandboxDomain("dom"));
+    }
+
+    @Test
+    public void filter_treatsTheDefaultServerAsNoHost() throws Exception {
+        String key = "k";
+        LabsAuthFilter filter = new LabsAuthFilter(key, List.of(WWW, EU), WWW + "/", true,
+                () -> System.currentTimeMillis() / 1000);
+        assertNull(principalHost(filter, key, "https://WWW.commcarehq.org/"));
+        assertEquals(EU, principalHost(filter, key, EU));
+    }
+
+    private static String principalHost(LabsAuthFilter filter, String key, String hostHeader)
+            throws Exception {
+        String body = "{\"username\": \"worker1\", \"domain\": \"dom\"}";
+        MockHttpServletRequest request = new MockHttpServletRequest("POST", "/navigate_menu");
+        request.setContentType("application/json");
+        request.setContent(body.getBytes(StandardCharsets.UTF_8));
+        request.addHeader(Constants.LABS_SIGNATURE_HEADER, LabsAuthFilter.sign(
+                key.getBytes(StandardCharsets.UTF_8), body.getBytes(StandardCharsets.UTF_8)));
+        request.addHeader(Constants.LABS_HQ_TOKEN_HEADER, "token");
+        request.addHeader(Constants.LABS_HQ_HOST_HEADER, hostHeader);
+        AtomicReference<HqUserDetailsBean> seen = new AtomicReference<>();
+        filter.doFilter(request, new MockHttpServletResponse(), (req, res) -> seen.set(
+                (HqUserDetailsBean)SecurityContextHolder.getContext().getAuthentication()
+                        .getPrincipal()));
+        SecurityContextHolder.clearContext();
+        return seen.get().getLabsHqHost();
+    }
+}
