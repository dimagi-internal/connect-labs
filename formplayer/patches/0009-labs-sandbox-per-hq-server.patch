diff --git a/src/main/java/org/commcare/formplayer/util/RequestUtils.java b/src/main/java/org/commcare/formplayer/util/RequestUtils.java
index 11d0d032..14b6cf70 100644
--- a/src/main/java/org/commcare/formplayer/util/RequestUtils.java
+++ b/src/main/java/org/commcare/formplayer/util/RequestUtils.java
@@ -123,6 +123,40 @@ public class RequestUtils {
         return getUserDetails().map(HqUserDetailsBean::isLabsSession).orElse(false);
     }
 
+    /**
+     * The name a user's sandbox (SQLite dirs) and sync-time key use for {@code domain}.
+     *
+     * <p>Labs mode: one formplayer serves workers on several HQ servers (X-Labs-HQ-Host), and the
+     * same domain and username can exist on two of them (www and eu are separate databases). A
+     * labs request for a non-default HQ server therefore keys its sandbox by
+     * {@code <domain>@<host slug>} (for example {@code my-domain@eu.commcarehq.org}), so the two
+     * workers never share cases or a sync token. '@' cannot occur in an HQ domain name. Every other
+     * request, including labs requests for the configured server, gets {@code domain} unchanged.
+     */
+    public static String getSandboxDomain(String domain) {
+        if (domain == null) {
+            return null;
+        }
+        String host = getUserDetails()
+                .filter(HqUserDetailsBean::isLabsSession)
+                .map(HqUserDetailsBean::getLabsHqHost)
+                .orElse(null);
+        if (host == null) {
+            return domain;
+        }
+        return domain + "@" + hqHostSlug(host);
+    }
+
+    /** "https://eu.commcarehq.org" -> "eu.commcarehq.org"; a non-default port is kept as "-port". */
+    static String hqHostSlug(String host) {
+        java.net.URI uri = java.net.URI.create(host.trim());
+        String slug = uri.getHost() != null ? uri.getHost() : host;
+        if (uri.getPort() != -1) {
+            slug = slug + "-" + uri.getPort();
+        }
+        return slug.toLowerCase(java.util.Locale.ROOT).replaceAll("[^a-z0-9.-]", "-");
+    }
+
     /**
      * @return True if there is request in the context AND the request was authenticated with HMAC
      * auth
