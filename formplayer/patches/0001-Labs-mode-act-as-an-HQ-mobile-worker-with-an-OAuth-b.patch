+import org.commcare.formplayer.util.RequestUtils;
+import org.commcare.util.JsonUtils;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.MediaType;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.security.web.authentication.WebAuthenticationDetailsSource;
+import org.springframework.security.web.authentication.preauth.PreAuthenticatedAuthenticationToken;
+import org.springframework.web.filter.GenericFilterBean;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.regex.Pattern;
+
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+
+import jakarta.servlet.FilterChain;
+import jakarta.servlet.ServletException;
+import jakarta.servlet.ServletRequest;
+import jakarta.servlet.ServletResponse;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import jakarta.servlet.http.Part;
+
+import lombok.extern.apachecommons.CommonsLog;
+
+/**
+ * Authenticates requests from the connect-labs backend ("Connect Web"), which drives formplayer as
+ * a CommCare mobile worker without an HQ Django session or HQ's HMAC key.
+ *
+ * <p>Only registered when {@code formplayer.labs.enabled=true}. A request is a labs request if it
+ * carries either {@link Constants#LABS_SIGNATURE_HEADER} or {@link Constants#LABS_HQ_TOKEN_HEADER};
+ * other requests pass through untouched to the HQ session / HMAC filters. A labs request must:
+ * <ul>
+ *   <li>be a POST;</li>
+ *   <li>carry {@code X-Labs-Signature}: Base64 (standard, padded) HMAC-SHA256, keyed with
+ *       {@code formplayer.labs.authKey}, of the exact raw request body bytes - or, for a
+ *       {@code multipart/form-data} request, of the bytes of its {@code application/json} part;</li>
+ *   <li>carry {@code X-Labs-HQ-Token}: the worker's HQ OAuth2 access token (scope {@code sync});
+ *       an optional {@code "Bearer "} prefix is accepted;</li>
+ *   <li>have a JSON body with {@code username} and {@code domain}, and no {@code restoreAs} /
+ *       {@code restoreAsCaseId} (labs always acts as the token's own user);</li>
+ *   <li>not also carry HQ's {@code X-MAC-DIGEST}.</li>
+ * </ul>
+ * Anything else gets a 401 and the chain stops. On success the principal is an
+ * {@link HqUserDetailsBean} for (username, domain) carrying the token, which
+ * {@code UserRestoreAspect} turns into {@link BearerTokenAuth} for every outbound HQ call.
+ *
+ * <p>The token is never logged.
+ */
+@CommonsLog
+public class LabsAuthFilter extends GenericFilterBean {
+
+    // RFC 6750 token68 characters. Rejecting anything else also rules out header injection.
+    private static final Pattern TOKEN_PATTERN = Pattern.compile("^[A-Za-z0-9\\-._~+/]+=*$");
+    private static final String BEARER_PREFIX = "Bearer ";
+
+    private final byte[] labsKey;
+    private final WebAuthenticationDetailsSource detailsSource = new WebAuthenticationDetailsSource();
+
+    public LabsAuthFilter(String labsKey) {
+        if (labsKey == null || labsKey.isBlank()) {
+            throw new IllegalArgumentException(
+                    "formplayer.labs.authKey must be set when formplayer.labs.enabled is true");
+        }
+        this.labsKey = labsKey.getBytes(StandardCharsets.UTF_8);
+    }
+
+    public static boolean isLabsRequest(HttpServletRequest request) {
+        return request.getHeader(Constants.LABS_SIGNATURE_HEADER) != null
+                || request.getHeader(Constants.LABS_HQ_TOKEN_HEADER) != null;
+    }
+
+    @Override
+    public void doFilter(ServletRequest req, ServletResponse res, FilterChain chain)
+            throws IOException, ServletException {
+        HttpServletRequest request = (HttpServletRequest)req;
+        HttpServletResponse response = (HttpServletResponse)res;
+        if (!isLabsRequest(request)) {
+            chain.doFilter(req, res);
+            return;
+        }
+        String failure;
+        try {
+            failure = authenticate(request);
+        } catch (Exception e) {
+            log.error("Labs request authentication failed unexpectedly", e);
+            failure = "unable to authenticate request";
+        }
+        if (failure != null) {
+            SecurityContextHolder.clearContext();
+            log.warn(String.format("Rejected labs request to %s: %s", request.getRequestURI(), failure));
+            response.sendError(HttpServletResponse.SC_UNAUTHORIZED, "Labs auth failed: " + failure);
+            return;
+        }
+        chain.doFilter(req, res);
+    }
+
+    /**
+     * @return null on success (the security context is populated), else the reason for rejection.
+     *         The reason never contains the token or the signature.
+     */
+    private String authenticate(HttpServletRequest request) throws Exception {
+        if (!HttpMethod.POST.matches(request.getMethod())) {
+            return "only POST is supported";
+        }
+        if (request.getHeader(Constants.HMAC_HEADER) != null) {
+            return "labs and HQ HMAC auth cannot be combined";
+        }
+        String signature = request.getHeader(Constants.LABS_SIGNATURE_HEADER);
+        if (signature == null || signature.isBlank()) {
+            return "missing " + Constants.LABS_SIGNATURE_HEADER;
+        }
+        String token = normalizeToken(request.getHeader(Constants.LABS_HQ_TOKEN_HEADER));
+        if (token == null) {
+            return "missing or malformed " + Constants.LABS_HQ_TOKEN_HEADER;
+        }
+
+        byte[] signedBytes = getSignedBytes(request);
+        if (signedBytes == null) {
+            return "multipart request has no application/json part";
+        }
+        if (!signatureMatches(signature.trim(), signedBytes)) {
+            return "invalid signature";
+        }
+
+        JSONObject body;
+        try {
+            body = new JSONObject(new String(signedBytes, StandardCharsets.UTF_8));
+        } catch (JSONException e) {
+            return "body is not a JSON object";
+        }
+        String username = body.optString("username", null);
+        String domain = body.optString("domain", null);
+        if (username == null || username.isBlank() || domain == null || domain.isBlank()) {
+            return "body must include username and domain";
+        }
+        if (!body.isNull("restoreAs") || !body.isNull("restoreAsCaseId")) {
+            return "restoreAs / restoreAsCaseId are not allowed on labs requests";
+        }
+
+        HqUserDetailsBean userDetails = new HqUserDetailsBean(
+                domain,
+                new String[]{domain},
+                username,
+                false,
+                JsonUtils.toArray(body.optJSONArray("enabled_toggles")),
+                JsonUtils.toArray(body.optJSONArray("enabled_previews"))
+        );
+        userDetails.setLabsHqToken(token);
+        PreAuthenticatedAuthenticationToken authentication = new PreAuthenticatedAuthenticationToken(
+                userDetails, null, userDetails.getAuthorities());
+        authentication.setDetails(detailsSource.buildDetails(request));
+        SecurityContextHolder.getContext().setAuthentication(authentication);
+        return null;
+    }
+
+    static String normalizeToken(String header) {
+        if (header == null) {
+            return null;
+        }
+        String token = header.trim();
+        if (token.regionMatches(true, 0, BEARER_PREFIX, 0, BEARER_PREFIX.length())) {
+            token = token.substring(BEARER_PREFIX.length()).trim();
+        }
+        if (token.isEmpty() || token.equalsIgnoreCase(BEARER_PREFIX.trim())
+                || !TOKEN_PATTERN.matcher(token).matches()) {
+            return null;
+        }
+        return token;
+    }
+
+    /**
+     * The exact bytes the signature covers: the raw body, or the JSON part of a multipart request
+     * (the file part is not read here, so Spring can still parse it).
+     */
+    private static byte[] getSignedBytes(HttpServletRequest request)
+            throws IOException, ServletException {
+        if (RequestUtils.isMultipart(request)) {
+            for (Part part : request.getParts()) {
+                if (part.getContentType() != null && MediaType.APPLICATION_JSON.isCompatibleWith(
+                        MediaType.parseMediaType(part.getContentType()))) {
+                    return IOUtils.toByteArray(part.getInputStream());
+                }
+            }
+            return null;
+        }
+        return IOUtils.toByteArray(request.getInputStream());
+    }
+
+    private boolean signatureMatches(String signature, byte[] data) throws Exception {
+        return MessageDigest.isEqual(
+                sign(labsKey, data).getBytes(StandardCharsets.US_ASCII),
+                signature.getBytes(StandardCharsets.US_ASCII));
+    }
+
+    /** Base64 HMAC-SHA256 of {@code data}; public so tests and docs share one definition. */
+    public static String sign(byte[] key, byte[] data) throws Exception {
+        Mac mac = Mac.getInstance("HmacSHA256");
+        mac.init(new SecretKeySpec(key, "HmacSHA256"));
+        return Base64.encodeBase64String(mac.doFinal(data));
+    }
+}
