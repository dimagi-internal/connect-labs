+package org.commcare.formplayer.auth;
+
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.commcare.formplayer.application.UtilController;
+import org.commcare.formplayer.configuration.CacheConfiguration;
+import org.commcare.formplayer.configuration.WebSecurityConfig;
+import org.commcare.formplayer.request.MultipleReadRequestWrappingFilter;
+import org.commcare.formplayer.services.FormplayerLockRegistry;
+import org.commcare.formplayer.util.Constants;
+import org.commcare.formplayer.utils.TestContext;
+import org.junit.jupiter.api.Nested;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
+import org.springframework.boot.test.mock.mockito.MockBean;
+import org.springframework.http.MediaType;
+import org.springframework.test.context.ContextConfiguration;
+import org.springframework.test.context.TestPropertySource;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
+
+import java.nio.charset.StandardCharsets;
+
+/**
+ * Wiring tests for labs (Connect Web) auth through the real {@link WebSecurityConfig} filter
+ * chain: signed requests reach a full-auth endpoint without an HQ session, CSRF token or HQ HMAC;
+ * bad ones get 401; and with labs mode off the labs headers authenticate nothing.
+ */
+public class LabsAuthTests {
+
+    static final String KEY = "labs-wiring-key";
+    static final String BODY = "{\"username\": \"worker1\", \"domain\": \"connect-dom\"}";
+
+    static MockHttpServletRequestBuilder labsRequest(String body, String signature) {
+        // Deliberately no CSRF token: labs calls are server-to-server.
+        return post("/" + Constants.URL_CLEAR_USER_DATA)
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(body)
+                .header(Constants.LABS_SIGNATURE_HEADER, signature)
+                .header(Constants.LABS_HQ_TOKEN_HEADER, "hq-token");
+    }
+
+    static String sign(String body) throws Exception {
+        return LabsAuthFilter.sign(KEY.getBytes(StandardCharsets.UTF_8),
+                body.getBytes(StandardCharsets.UTF_8));
+    }
+
+    @Nested
+    @WebMvcTest
+    @ContextConfiguration(classes = {
+            UtilController.class,
+            TestContext.class,
+            WebSecurityConfig.class,
+            MultipleReadRequestWrappingFilter.class,
+            CacheConfiguration.class
+    })
+    @TestPropertySource(properties = {
+            "formplayer.labs.enabled=true",
+            "formplayer.labs.authKey=" + KEY
+    })
+    class Enabled {
+        @Autowired
+        private MockMvc mvc;
+
+        @MockBean
+        private FormplayerLockRegistry lockRegistry;
+
+        @Test
+        public void signedRequest_reachesFullAuthEndpoint() throws Exception {
+            mvc.perform(labsRequest(BODY, sign(BODY))).andExpect(status().isOk());
+        }
+
+        @Test
+        public void badSignature_is401() throws Exception {
+            mvc.perform(labsRequest(BODY, sign("{}"))).andExpect(status().isUnauthorized());
+        }
+
+        @Test
+        public void missingToken_is401() throws Exception {
+            mvc.perform(post("/" + Constants.URL_CLEAR_USER_DATA)
+                    .contentType(MediaType.APPLICATION_JSON)
+                    .content(BODY)
+                    .header(Constants.LABS_SIGNATURE_HEADER, sign(BODY)))
+                    .andExpect(status().isUnauthorized());
+        }
+
+        @Test
+        public void unsignedNonLabsRequest_isStillForbidden() throws Exception {
+            mvc.perform(AuthTestUtils.getFullAuthRequestBuilder(BODY))
+                    .andExpect(status().isForbidden());
+        }
+    }
+
+    @Nested
+    @WebMvcTest
+    @ContextConfiguration(classes = {
+            UtilController.class,
+            TestContext.class,
+            WebSecurityConfig.class,
+            MultipleReadRequestWrappingFilter.class,
+            CacheConfiguration.class
+    })
+    class Disabled {
+        @Autowired
+        private MockMvc mvc;
+
+        @MockBean
+        private FormplayerLockRegistry lockRegistry;
+
+        @Test
+        public void labsHeaders_authenticateNothingWhenLabsModeIsOff() throws Exception {
+            mvc.perform(labsRequest(BODY, sign(BODY))).andExpect(status().isForbidden());
+        }
+    }
+}
