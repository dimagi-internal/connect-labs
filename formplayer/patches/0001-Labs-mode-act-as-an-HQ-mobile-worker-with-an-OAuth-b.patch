diff --git a/src/main/java/org/commcare/formplayer/auth/BearerTokenAuth.java b/src/main/java/org/commcare/formplayer/auth/BearerTokenAuth.java
new file mode 100644
index 00000000..6fd381f5
--- /dev/null
+++ b/src/main/java/org/commcare/formplayer/auth/BearerTokenAuth.java
@@ -0,0 +1,35 @@
+package org.commcare.formplayer.auth;
+
+import org.springframework.http.HttpHeaders;
+
+/**
+ * {@link HqAuth} that authenticates formplayer's outbound calls to HQ (restore, form submission,
+ * case search, remote instances) with an HQ OAuth2 bearer token.
+ *
+ * Used for requests authenticated by {@link LabsAuthFilter}: the labs backend obtains a short-lived
+ * token for the mobile worker from HQ's {@code /oauth/token/} and forwards it on every request, so
+ * HQ sees every call as that worker. The token is never logged (see {@link #toString()}).
+ */
+public class BearerTokenAuth implements HqAuth {
+
+    private final String token;
+
+    public BearerTokenAuth(String token) {
+        if (token == null || token.isEmpty()) {
+            throw new IllegalArgumentException("A bearer token is required");
+        }
+        this.token = token;
+    }
+
+    @Override
+    public HttpHeaders getAuthHeaders() {
+        HttpHeaders headers = new HttpHeaders();
+        headers.setBearerAuth(token);
+        return headers;
+    }
+
+    @Override
+    public String toString() {
+        return "BearerTokenAuth";
+    }
+}
