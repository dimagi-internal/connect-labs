new file mode 100644
index 00000000..890ae078
--- /dev/null
+++ b/src/main/java/org/commcare/formplayer/util/MetaLocationUtils.java
@@ -0,0 +1,92 @@
+package org.commcare.formplayer.util;
+
+import org.javarosa.core.model.data.GeoPointData;
+import org.javarosa.core.model.data.IAnswerData;
+import org.javarosa.core.model.data.UncastData;
+import org.javarosa.core.model.instance.FormInstance;
+import org.javarosa.core.model.instance.TreeElement;
+
+/**
+ * Fills a form's OpenRosa {@code meta/location} from a location the client supplies.
+ *
+ * <p>On Android, {@code meta/location} is filled by {@code <orx:pollsensor>}, an action only
+ * commcare-android implements; formplayer ignores it, so Web Apps forms submit an empty
+ * location. Connect Web passes the browser's GPS fix with {@code submit-all} instead, and this
+ * writes it into the instance just before the XML is serialized for HQ.
+ */
+public class MetaLocationUtils {
+
+    private MetaLocationUtils() {
+    }
+
+    /**
+     * Sets {@code meta/location} to {@code location} if the form has that node and it is empty.
+     *
+     * @param location an XForms geopoint: "lat lon [altitude [accuracy]]", space separated
+     * @return true if the node was set
+     * @throws IllegalArgumentException if {@code location} is not a valid geopoint
+     */
+    public static boolean setMetaLocationIfEmpty(FormInstance instance, String location) {
+        if (instance == null || location == null || location.isBlank()) {
+            return false;
+        }
+        GeoPointData geoPoint = parseGeoPoint(location);
+        // HQ puts meta directly under the root; fall back to the depth-first rule javarosa's
+        // FormController uses for submission metadata.
+        TreeElement meta = instance.getRoot().getChild("meta", 0);
+        if (meta == null) {
+            meta = findDepthFirst(instance.getRoot(), "meta");
+        }
+        if (meta == null) {
+            return false;
+        }
+        TreeElement locationNode = meta.getChild("location", 0);
+        if (locationNode == null) {
+            return false;
+        }
+        IAnswerData existing = locationNode.getValue();
+        if (existing != null && !existing.uncast().getString().isBlank()) {
+            return false;
+        }
+        locationNode.setValue(geoPoint);
+        return true;
+    }
+
+    static GeoPointData parseGeoPoint(String location) {
+        String[] parts = location.trim().split("\\s+");
+        if (parts.length < 2 || parts.length > 4) {
+            throw new IllegalArgumentException(
+                    "meta location must be 'lat lon [altitude [accuracy]]', got " + parts.length
+                            + " values");
+        }
+        GeoPointData geoPoint;
+        try {
+            geoPoint = new GeoPointData().cast(new UncastData(location.trim()));
+        } catch (NumberFormatException e) {
+            throw new IllegalArgumentException("meta location contains a non-numeric value", e);
+        }
+        double lat = geoPoint.getLatitude();
+        double lon = geoPoint.getLongitude();
+        if (lat < -90 || lat > 90 || lon < -180 || lon > 180) {
+            throw new IllegalArgumentException("meta location latitude/longitude out of range");
+        }
+        return geoPoint;
+    }
+
+    private static TreeElement findDepthFirst(TreeElement parent, String name) {
+        if (parent == null) {
+            return null;
+        }
+        for (int i = 0; i < parent.getNumChildren(); i++) {
+            TreeElement child = parent.getChildAt(i);
+            if (name.equals(child.getName())) {
+                return child;
+            }
+            TreeElement found = findDepthFirst(child, name);
+            if (found != null) {
+                return found;
+            }
+        }
+        return null;
+    }
+}
