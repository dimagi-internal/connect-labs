+++ b/src/test/java/org/commcare/formplayer/auth/LabsAuthFilterTest.java
@@ -0,0 +1,207 @@
+package org.commcare.formplayer.auth;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.commcare.formplayer.beans.auth.HqUserDetailsBean;
+import org.commcare.formplayer.util.Constants;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.MediaType;
+import org.springframework.mock.web.MockFilterChain;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.mock.web.MockHttpServletResponse;
+import org.springframework.mock.web.MockMultipartHttpServletRequest;
+import org.springframework.mock.web.MockPart;
+import org.springframework.security.core.Authentication;
+import org.springframework.security.core.context.SecurityContextHolder;
+
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.atomic.AtomicReference;
+
+import jakarta.servlet.http.HttpServletResponse;
+
+/**
+ * Unit tests for {@link LabsAuthFilter}: signature, token and body checks, and the principal it
+ * produces.
+ */
+public class LabsAuthFilterTest {
+
+    private static final String KEY = "labs-test-key";
+    private static final String TOKEN = "hq-oauth-token-123";
+    private static final String BODY = "{\"username\": \"worker1\", \"domain\": \"connect-dom\"}";
+
+    private final LabsAuthFilter filter = new LabsAuthFilter(KEY);
+
+    @AfterEach
+    public void clearContext() {
+        SecurityContextHolder.clearContext();
+    }
+
+    private static String sign(String body) throws Exception {
+        return LabsAuthFilter.sign(KEY.getBytes(StandardCharsets.UTF_8),
+                body.getBytes(StandardCharsets.UTF_8));
+    }
+
+    private static MockHttpServletRequest request(String body, String signature, String token) {
+        MockHttpServletRequest request = new MockHttpServletRequest("POST", "/navigate_menu");
+        request.setContentType(MediaType.APPLICATION_JSON_VALUE);
+        request.setContent(body.getBytes(StandardCharsets.UTF_8));
+        if (signature != null) {
+            request.addHeader(Constants.LABS_SIGNATURE_HEADER, signature);
+        }
+        if (token != null) {
+            request.addHeader(Constants.LABS_HQ_TOKEN_HEADER, token);
+        }
+        return request;
+    }
+
+    /** Runs the filter; returns the authentication seen downstream, or null if the chain stopped. */
+    private Result run(MockHttpServletRequest request) throws Exception {
+        MockHttpServletResponse response = new MockHttpServletResponse();
+        AtomicReference<Authentication> seen = new AtomicReference<>();
+        final boolean[] called = {false};
+        MockFilterChain chain = new MockFilterChain() {
+            @Override
+            public void doFilter(jakarta.servlet.ServletRequest req,
+                    jakarta.servlet.ServletResponse res) {
+                called[0] = true;
+                seen.set(SecurityContextHolder.getContext().getAuthentication());
+            }
+        };
+        filter.doFilter(request, response, chain);
+        return new Result(response, called[0], seen.get());
+    }
+
+    private record Result(MockHttpServletResponse response, boolean chainCalled, Authentication auth) {
+    }
+
+    @Test
+    public void goodSignature_authenticatesAsWorkerAndCarriesToken() throws Exception {
+        Result result = run(request(BODY, sign(BODY), TOKEN));
+
+        assertTrue(result.chainCalled());
+        assertNotNull(result.auth());
+        HqUserDetailsBean principal = (HqUserDetailsBean)result.auth().getPrincipal();
+        assertEquals("worker1", principal.getUsername());
+        assertEquals("connect-dom", principal.getDomain());
+        assertTrue(principal.isLabsSession());
+        assertEquals(TOKEN, principal.getLabsHqToken());
+        assertFalse(principal.isPublicSession());
+        assertFalse(principal.toString().contains(TOKEN));
+    }
+
+    @Test
+    public void bearerPrefixOnTokenHeader_isAccepted() throws Exception {
+        Result result = run(request(BODY, sign(BODY), "Bearer " + TOKEN));
+        assertTrue(result.chainCalled());
+        assertEquals(TOKEN, ((HqUserDetailsBean)result.auth().getPrincipal()).getLabsHqToken());
+    }
+
+    @Test
+    public void badSignature_is401AndStopsChain() throws Exception {
+        Result result = run(request(BODY, sign("{\"other\": 1}"), TOKEN));
+        assertUnauthorized(result);
+    }
+
+    @Test
+    public void signatureWithWrongKey_is401() throws Exception {
+        String wrong = LabsAuthFilter.sign("not-the-key".getBytes(StandardCharsets.UTF_8),
+                BODY.getBytes(StandardCharsets.UTF_8));
+        assertUnauthorized(run(request(BODY, wrong, TOKEN)));
+    }
+
+    @Test
+    public void tamperedBody_is401() throws Exception {
+        String signature = sign(BODY);
+        String tampered = BODY.replace("worker1", "worker2");
+        assertUnauthorized(run(request(tampered, signature, TOKEN)));
+    }
+
+    @Test
+    public void missingToken_is401() throws Exception {
+        assertUnauthorized(run(request(BODY, sign(BODY), null)));
+    }
+
+    @Test
+    public void malformedToken_is401() throws Exception {
+        assertUnauthorized(run(request(BODY, sign(BODY), "abc\r\nX-Evil: 1")));
+        assertUnauthorized(run(request(BODY, sign(BODY), "Bearer ")));
+    }
+
+    @Test
+    public void missingSignature_is401() throws Exception {
+        assertUnauthorized(run(request(BODY, null, TOKEN)));
+    }
+
+    @Test
+    public void missingUsernameOrDomain_is401() throws Exception {
+        String body = "{\"domain\": \"connect-dom\"}";
+        assertUnauthorized(run(request(body, sign(body), TOKEN)));
+    }
+
+    @Test
+    public void restoreAs_is401() throws Exception {
+        String body = "{\"username\": \"worker1\", \"domain\": \"connect-dom\", \"restoreAs\": \"x\"}";
+        assertUnauthorized(run(request(body, sign(body), TOKEN)));
+    }
+
+    @Test
+    public void combinedWithHqHmac_is401() throws Exception {
+        MockHttpServletRequest request = request(BODY, sign(BODY), TOKEN);
+        request.addHeader(Constants.HMAC_HEADER, "anything");
+        assertUnauthorized(run(request));
+    }
+
+    @Test
+    public void getRequest_is401() throws Exception {
+        MockHttpServletRequest request = request(BODY, sign(BODY), TOKEN);
+        request.setMethod("GET");
+        assertUnauthorized(run(request));
+    }
+
+    @Test
+    public void nonLabsRequest_passesThroughUnauthenticated() throws Exception {
+        Result result = run(request(BODY, null, null));
+        assertTrue(result.chainCalled());
+        assertNull(result.auth());
+        assertEquals(HttpServletResponse.SC_OK, result.response().getStatus());
+    }
+
+    @Test
+    public void multipart_signsTheJsonPart() throws Exception {
+        MockMultipartHttpServletRequest request = new MockMultipartHttpServletRequest();
+        request.setMethod("POST");
+        request.setRequestURI("/answer_media");
+        request.setContentType(MediaType.MULTIPART_FORM_DATA_VALUE + "; boundary=xyz");
+        MockPart json = new MockPart("answer", BODY.getBytes(StandardCharsets.UTF_8));
+        json.getHeaders().setContentType(MediaType.APPLICATION_JSON);
+        request.addPart(json);
+        request.addPart(new MockPart("file", "photo.jpg", new byte[]{1, 2, 3}));
+        request.addHeader(Constants.LABS_SIGNATURE_HEADER, sign(BODY));
+        request.addHeader(Constants.LABS_HQ_TOKEN_HEADER, TOKEN);
+
+        Result result = run(request);
+
+        assertTrue(result.chainCalled());
+        assertEquals("worker1", ((HqUserDetailsBean)result.auth().getPrincipal()).getUsername());
+    }
+
+    @Test
+    public void blankKey_refusesToStart() {
+        assertThrows(IllegalArgumentException.class, () -> new LabsAuthFilter(""));
+        assertThrows(IllegalArgumentException.class, () -> new LabsAuthFilter(null));
+    }
+
+    private static void assertUnauthorized(Result result) {
+        assertFalse(result.chainCalled());
+        assertEquals(HttpServletResponse.SC_UNAUTHORIZED, result.response().getStatus());
+        assertNull(SecurityContextHolder.getContext().getAuthentication());
+        String message = result.response().getErrorMessage();
+        assertTrue(message == null || !message.contains(TOKEN));
+    }
+}
