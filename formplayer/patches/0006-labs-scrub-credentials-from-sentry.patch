 Build and image: `./gradlew bootJar` (JDK 17) produces `build/libs/formplayer.jar`. Then
 `docker build .` builds the image. The Dockerfile copies the prebuilt jar and does not compile.
diff --git a/src/main/java/org/commcare/formplayer/configuration/LabsSentryConfig.java b/src/main/java/org/commcare/formplayer/configuration/LabsSentryConfig.java
new file mode 100644
index 00000000..077d9162
--- /dev/null
+++ b/src/main/java/org/commcare/formplayer/configuration/LabsSentryConfig.java
@@ -0,0 +1,75 @@
+package org.commcare.formplayer.configuration;
+
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+
+import java.util.LinkedHashMap;
+import java.util.Locale;
+import java.util.Map;
+
+import io.sentry.SentryBaseEvent;
+import io.sentry.SentryOptions;
+import io.sentry.protocol.Request;
+
+/**
+ * Labs mode: keep credentials out of Sentry.
+ *
+ * <p>Upstream sets {@code sentry.send-default-pii=true}, and Sentry's servlet integration then
+ * attaches every request header to an event. Even with PII off, Sentry only drops its own list of
+ * sensitive headers, which does not include labs' {@code X-Labs-HQ-Token} (a worker's live HQ
+ * token). This scrubber runs on every event and transaction before it leaves the process and
+ * removes the token, the labs signatures, {@code Authorization}, HQ's HMAC digest and cookies,
+ * whatever the PII setting. Only registered when labs mode is on; upstream is unchanged otherwise.
+ */
+@Configuration
+@ConditionalOnProperty(name = "formplayer.labs.enabled", havingValue = "true")
+public class LabsSentryConfig {
+
+    @Bean
+    public SentryOptions.BeforeSendCallback labsSentryBeforeSend() {
+        return (event, hint) -> scrub(event);
+    }
+
+    @Bean
+    public SentryOptions.BeforeSendTransactionCallback labsSentryBeforeSendTransaction() {
+        return (transaction, hint) -> scrub(transaction);
+    }
+
+    static boolean isSensitiveHeader(String name) {
+        if (name == null) {
+            return false;
+        }
+        String n = name.toLowerCase(Locale.ROOT);
+        return n.equals("x-labs-hq-token")
+                || n.startsWith("x-labs-signature")
+                || n.equals("authorization")
+                || n.equals("proxy-authorization")
+                || n.equals("cookie")
+                || n.equals("set-cookie")
+                || n.equals("x-mac-digest")
+                || n.equals("x-csrftoken");
+    }
+
+    /** Removes credential headers and cookies from the event's request, in place. */
+    public static <T extends SentryBaseEvent> T scrub(T event) {
+        if (event == null) {
+            return null;
+        }
+        Request request = event.getRequest();
+        if (request != null) {
+            Map<String, String> headers = request.getHeaders();
+            if (headers != null) {
+                Map<String, String> kept = new LinkedHashMap<>();
+                headers.forEach((name, value) -> {
+                    if (!isSensitiveHeader(name)) {
+                        kept.put(name, value);
+                    }
+                });
+                request.setHeaders(kept);
+            }
+            request.setCookies(null);
+        }
+        return event;
+    }
+}
