diff --git a/src/test/java/org/commcare/formplayer/configuration/LabsSentryConfigTest.java b/src/test/java/org/commcare/formplayer/configuration/LabsSentryConfigTest.java
new file mode 100644
index 00000000..2a7efda2
--- /dev/null
+++ b/src/test/java/org/commcare/formplayer/configuration/LabsSentryConfigTest.java
@@ -0,0 +1,73 @@
+package org.commcare.formplayer.configuration;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import io.sentry.Hint;
+import io.sentry.SentryEvent;
+import io.sentry.protocol.Request;
+import io.sentry.protocol.SentryTransaction;
+
+public class LabsSentryConfigTest {
+
+    private static Request labsRequest() {
+        Map<String, String> headers = new LinkedHashMap<>();
+        headers.put("Content-Type", "application/json");
+        headers.put("X-Labs-HQ-Token", "live-hq-token");
+        headers.put("x-labs-signature", "sig-v1");
+        headers.put("X-Labs-Signature-V2", "sig-v2");
+        headers.put("X-Labs-Timestamp", "1767225600");
+        headers.put("X-Labs-HQ-Host", "https://eu.commcarehq.org");
+        headers.put("Authorization", "Bearer live-hq-token");
+        headers.put("Cookie", "sessionid=abc");
+        headers.put("X-MAC-DIGEST", "hmac");
+        Request request = new Request();
+        request.setHeaders(headers);
+        request.setCookies("sessionid=abc");
+        request.setUrl("http://formplayer/navigate_menu");
+        return request;
+    }
+
+    @Test
+    public void beforeSend_removesCredentialsAndKeepsTheRest() {
+        SentryEvent event = new SentryEvent();
+        event.setRequest(labsRequest());
+
+        SentryEvent sent = new LabsSentryConfig().labsSentryBeforeSend().execute(event, new Hint());
+
+        assertSame(event, sent);
+        Map<String, String> headers = sent.getRequest().getHeaders();
+        assertEquals(Map.of(
+                "Content-Type", "application/json",
+                "X-Labs-Timestamp", "1767225600",
+                "X-Labs-HQ-Host", "https://eu.commcarehq.org"), headers);
+        assertNull(sent.getRequest().getCookies());
+        assertEquals("http://formplayer/navigate_menu", sent.getRequest().getUrl());
+        assertEquals(-1, sent.toString().indexOf("live-hq-token"));
+    }
+
+    @Test
+    public void beforeSendTransaction_scrubsToo() {
+        SentryTransaction transaction = new SentryTransaction(
+                "navigate_menu", 0.0, null, new java.util.ArrayList<>(), new java.util.HashMap<>(),
+                new io.sentry.protocol.TransactionInfo("custom"));
+        transaction.setRequest(labsRequest());
+
+        new LabsSentryConfig().labsSentryBeforeSendTransaction().execute(transaction, new Hint());
+
+        assertEquals(null, transaction.getRequest().getHeaders().get("X-Labs-HQ-Token"));
+        assertEquals(null, transaction.getRequest().getHeaders().get("Authorization"));
+    }
+
+    @Test
+    public void eventWithoutRequest_isUntouched() {
+        SentryEvent event = new SentryEvent();
+        assertSame(event, LabsSentryConfig.scrub(event));
+    }
+}
